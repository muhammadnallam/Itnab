
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// UUID is chosen over CUID2 to leverage the native support and database optimization.
// Additionally, the platform manages articles URLs with slugs not with IDs (CUID2's main benefit).

enum ReactionType {
    LIKE
    DISLIKE
}

enum DeviceType {
    DESKTOP
    MOBILE
    OTHER
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  username    String   @unique
  bio         String?
  bannerUrl   String?
  preferences    Json?
  socialLinks    Json?
  followerCount    Int      @default(0)
  followingCount   Int      @default(0)
  createdAt   DateTime @default(now())

  articles      Article[]
  lists List[]
  following     Follow[]   @relation("follower")
  followers     Follow[]   @relation("following")
  likes         Like[]
  bookmarks     Bookmark[]
  shares        Share[]
  views         View[]     @relation("userViews")
  comments      Comment[]
  commentLikes  CommentLike[]

  name          String
  emailVerified Boolean    @default(false)
  image         String?
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@index([name])
  @@map("user")
}

model Article {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  title          String
  subtitle       String
  seoTitle       String
  seoSubtitle    String
  topic          String
  coverImage     String
  content        Json
  searchVector   String?
  readTime       Int
  score          Float    @default(0)

  likeCount      Int      @default(0)
  dislikeCount   Int      @default(0)
  savedCount     Int      @default(0)
  shareCount     Int      @default(0)
  viewCount      Int      @default(0)
  commentCount   Int      @default(0)
  
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  savedArticles SavedArticle[]
  likes     Like[]
  bookmarks Bookmark[]
  shares    Share[]
  views     View[]       @relation("articleViews")
  comments  Comment[]

  @@index([topic, createdAt(sort: Desc)])
}

model List {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  isDefault Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  savedArticles SavedArticle[]

  @@map("list")
}

// Interactions were separated to simplify queries and make indexing more efficient.
// createdAt are recorded for a planned writer statistics feature.

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model Like {
  userId    String   @db.Uuid
  articleId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  type      ReactionType @default(LIKE)

  @@id([userId, articleId])
}

model Bookmark {
  userId    String   @db.Uuid
  articleId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, articleId])
}

model Share {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  guestId   String?
  articleId String   @db.Uuid
  platform  String   @default("copy")
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  article Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

// Logged in views are counted once per user (@@unique), unlike unlimited guest views.

model View {
  id        String   @id @default(uuid()) @db.Uuid
  userId     String?    @db.Uuid
  guestId    String?
  articleId String   @db.Uuid
  deviceType DeviceType @default(OTHER)
  country    String?
  browser    String?
  os         String?
  referrer   String?
  createdAt  DateTime   @default(now())
  lastReadDate DateTime @default(now())

  user      User?    @relation("userViews", fields: [userId], references: [id])
  article   Article  @relation("articleViews", fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@unique([guestId, articleId])
  @@index([articleId])
}

model SavedArticle {
  listId    String   @db.Uuid
  articleId String   @db.Uuid
  createdAt DateTime @default(now())

  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([listId, articleId])
  @@index([articleId])
}

// Manage threaded comments with nesting replies (max depth 3).

model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  content    String
  depth      Int       @default(1) // 1 = top-level, max 3
  likeCount  Int       @default(0)
  replyCount Int       @default(0) // top-level: total thread replies; replies: direct children
  isEdited   Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  articleId String  @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String  @db.Uuid
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?  @db.Uuid
  parent    Comment? @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("commentReplies")
  rootId    String?  @db.Uuid // null for top-level; depth-1 ancestor otherwise
  root      Comment? @relation("commentThread", fields: [rootId], references: [id], onDelete: Cascade)
  threadComments Comment[] @relation("commentThread")
  likes     CommentLike[]

  @@index([articleId, depth])
  @@index([rootId])
  @@index([parentId])
}

model CommentLike {
  userId    String   @db.Uuid
  commentId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
